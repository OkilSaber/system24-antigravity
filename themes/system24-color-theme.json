    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8a8a8a",
                "fontStyle": ""
            }
        },
        {
            "scope": [
                "keyword",
                "storage",
                "storage.type",
                "keyword.operator.new",
                "keyword.control"
            ],
            "settings": {
                "foreground": "#c49be3"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "punctuation",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#a6a6a6"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "markup.inline.raw"
            ],
            "settings": {
                "foreground": "#5cc4a5"
            }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#d8bc6a"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.other",
                "support.constant",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#d8bc6a"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": {
                "foreground": "#6cc3d6"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "entity.name.module",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#d4b3ee"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#d6d6d6"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#bdbdbd"
            }
        },
        {
            "scope": [
                "variable.language",
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#ef7d96"
            }
        },
        {
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#c49be3"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#d8bc6a"
            }
        },
        {
            "scope": [
                "support.type.property-name",
                "meta.object-literal.key"
            ],
            "settings": {
                "foreground": "#bdbdbd"
            }
        },
        {
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#d4b3ee",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "emphasis",
                "storage.modifier",
                "variable.language",
                "entity.other.attribute-name"
            ],
            "settings": {
                "fontStyle": ""
            }
        },
        {
            "scope": [
                "markup.underline.link"
            ],
            "settings": {
                "foreground": "#d4b3ee"
            }
        },
        {
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#5cc4a5"
            }
        },
        {
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#ef7d96"
            }
        },
        {
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#6cc3d6"
            }
        },
        {
            "scope": [
                "invalid"
            ],
            "settings": {
                "foreground": "#ef7d96"
            }
        }
    ]
}
